# Copy to .env and adjust as needed. Never commit the real .env file.

# Port for the Flask server
PORT=5000
HOST=127.0.0.1
FLASK_DEBUG=0

# Server-webcam mode only: camera index (0 = first webcam) or an
# IP-camera MJPEG/HTTP URL supported by OpenCV.
CAMERA_SOURCE=0

# Model artifacts (defaults live in models/)
# MODEL_PATH=models/mask_classifier.keras
# CLASS_LABELS_PATH=models/class_labels.json

# Minimum confidence the UI highlights for a "positive" reading
CONFIDENCE_THRESHOLD=0.50

# Inference image size; should match the value written at training time
IMAGE_SIZE=128
